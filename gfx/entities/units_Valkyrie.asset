	#手臂骨骼存在缩放比例不为1，在同一状态若没有looping = yes会出现骨骼错位
	state = { name = "idle"  animation = "Idle1"   animation_blend_time = 0.1  animation_speed = 0.7 looping = yes }

	state = { name = "move"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 0.7 looping = yes }
	state = { name = "retreat"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 0.7 looping = yes }

	state = { name = "training"  animation = "Idle1"   animation_blend_time = 0.1   animation_speed = 0.7 looping = yes }

	state = { name = "attack"  animation = "Attack2"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "attack"  chance = 1
		propagate_state = { Mei_Captain_Skirt = "attack1" }
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack2" } }
	}
	state = { name = "attack"  animation = "Attack1"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "attack"  chance = 1
		propagate_state = { Mei_Captain_Skirt = "attack2" }
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack1" } }
	}
	state = { name = "attack"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 0.7 looping = no  next_state = "attack"  chance = 2 
		propagate_state = { Mei_Captain_Skirt = "attack3" }
	}
	state = { name = "attack"  animation = "Attack2"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "attack"  chance = 5
		propagate_state = { Mei_Captain_Skirt = "attack4" }
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack2" } }
	}

	state = { name = "defend"  animation = "Attack1"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "defend"  chance = 1
		propagate_state = { Mei_Captain_Skirt = "defend1" }	
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack1" } }
	}
	state = { name = "defend"  animation = "Attack2"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "defend"  chance = 2
		propagate_state = { Mei_Captain_Skirt = "defend2" }	
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack2" } }
	}


	state = { name = "support_attack"  animation = "Attack1"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "support_attack"  chance = 1
		propagate_state = { Mei_Captain_Skirt = "support_attack1" }	
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack1" } }
	}
	state = { name = "support_attack"  animation = "Attack2"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "support_attack"  chance = 1
		propagate_state = { Mei_Captain_Skirt = "support_attack2" }
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack2" } }
	}
	state = { name = "support_attack"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 0.7 looping = no  next_state = "support_attack"  chance = 2
		propagate_state = { Mei_Captain_Skirt = "support_attack3" }
	}
	state = { name = "support_attack"  animation = "Attack1"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "support_attack"  chance = 5
		propagate_state = { Mei_Captain_Skirt = "support_attack4" }	
		event = { time = 0  sound = { soundeffect = "Mei_Captain_Attack1" } }
	}

