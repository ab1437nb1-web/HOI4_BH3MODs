########### 休伯利安 ###########
entity = {
	name = "BH3_Hyperion_entity"
	pdxmesh = "BH3_Hyperion_pdx"
		
	state = { name = "Idle"  animation = "Idle"   animation_blend_time = 0.1  animation_speed = 1.5 looping = yes 
		event = { time = 0  sound = { soundeffect = "Hyperion_jet_idle" } }
	}
	state = { name = "Move"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 1.5 looping = yes 
		event = { time = 0  sound = { soundeffect = "Hyperion_jet_idle" } }
	}
	scale = 0.05
}
entity = { #未启用，效果差
	name = "BH3_Laser_entity"
	pdxmesh = "BH3_Laser_pdx"
		
	state = { name = "attack"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "attack" 
		#event = { time = 0  sound = { soundeffect = "airplane_jet_idle" } }
	}
	scale = 0.03
}
entity = { # 休伯利炸弹效果
	name = "BH3_Hyperion_Fire_Effect_entity"	
	pdxmesh = "nuke_mesh"
	
	state = { name = "attack" animation = attack looping = no
		event = { time = 2.5 particle = "nuke_particle" keep_particle = yes sound = { soundeffect = "nuke" } }
		event = { node = nuke time = 2.5 particle = "nuke_top_particle" keep_particle = yes light = nuke_light }
	}
	scale = 0.7
}

