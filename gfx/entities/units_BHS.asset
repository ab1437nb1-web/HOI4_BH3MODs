######## SishiBHS ########
entity = {
	name = "SishiBHS_entity"
	pdxmesh = "SishiBHS_pdx"

	state = { name = "idle"  animation = "Idle"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "idle"  }

	state = { name = "move"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "move" 
		#event = { time = 0  sound = { soundeffect = "airplane_jet_idle" } }
	}
	state = { name = "retreat"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "move" 
		#event = { time = 0  sound = { soundeffect = "airplane_jet_idle" } }
	}

	state = { name = "training"  animation = "Idle"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "training"  }

	state = { name = "attack"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "attack"  chance = 1
		event = { time = 0  sound = { soundeffect = "BHS_Attack" } }
	}
	state = { name = "attack"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "attack"  chance = 1
		event = { time = 0  sound = { soundeffect = "BHS_Attack" } }
	}
	state = { name = "attack"  animation = "Move"   animation_blend_time = 0.1  animation_speed = 1 looping = no  next_state = "attack"  chance = 2 
	}
	state = { name = "attack"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "attack"  chance = 5
		event = { time = 0  sound = { soundeffect = "BHS_Attack" } }
	}

	state = { name = "defend"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "defend"  chance = 1
		event = { time = 0  sound = { soundeffect = "BHS_Attack" } }
	}
	state = { name = "defend"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "defend"  chance = 2
		event = { time = 0  sound = { soundeffect = "BHS_Attack" } }
	}

	state = { name = "support_attack"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "support_attack"  chance = 1
		event = { time = 0  sound = { soundeffect = "BHS_Attack" } }
	}
	state = { name = "support_attack"  animation = "Attack"   animation_blend_time = 0.1  animation_speed = 0.8 looping = no  next_state = "support_attack"  chance = 2
		event = { time = 0  sound = { soundeffect = "BHS_Attack" } }
	}
	#正常比例为4
	scale = 0.04
}
entity = {
	clone =  "SishiBHS_entity"
	name = "SishiBHS_0_entity"
	pdxmesh = "SishiBHS_pdx"
}

