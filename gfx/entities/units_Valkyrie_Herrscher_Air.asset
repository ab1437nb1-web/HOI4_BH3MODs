#####################################
##### 律者级空中女武神实体 ##########
#####################################
# 复用陆上律者模型（mesh 与动画名取自 units_Valkyrie.asset 中对应实体），
# 状态换为空军六态：fire / bomb / firebomb / idle / crash / explode。
# scale 沿用该 mesh 在陆上 _0_entity 中的比例。

entity = {
	name = "HerrscherVoidKianaAir_entity"
	pdxmesh = "Kiana_HerrscherofVoid_pdx"

	state = { name = "fire" animation = "Attack1" animation_blend_time = 0.1 animation_speed = 1.0 looping = no next_state = "fire" }
	state = { name = "bomb" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.7 looping = no next_state = "bomb" }
	state = { name = "firebomb" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.7 looping = no next_state = "firebomb" }
	state = { name = "idle" animation = "Idle1" animation_blend_time = 0.1 animation_speed = 0.5 looping = no next_state = "idle" }
	state = { name = "crash" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.7 looping = no next_state = "crash" }
	state = { name = "explode" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.7 looping = no next_state = "explode" }

	scale = 0.07
}

