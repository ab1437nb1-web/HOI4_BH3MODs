# 理之律者·布洛妮娅（mesh Bronya_HerrscherofReason_pdx，动画取自陆上同名实体）
entity = {
	name = "HerrscherReasonBronyaAir_entity"
	pdxmesh = "Bronya_HerrscherofReason_pdx"

	state = { name = "fire" animation = "Attack1" animation_blend_time = 0.1 animation_speed = 1.0 looping = no next_state = "fire" }
	state = { name = "bomb" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.7 looping = no next_state = "bomb" }
	state = { name = "firebomb" animation = "Fire" animation_blend_time = 0.1 animation_speed = 1.2 looping = no next_state = "firebomb" }
	state = { name = "idle" animation = "Idle1" animation_blend_time = 0.1 animation_speed = 0.5 looping = no next_state = "idle" }
	state = { name = "crash" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.7 looping = no next_state = "crash" }
	state = { name = "explode" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.7 looping = no next_state = "explode" }

	scale = 0.07
}

# 死生之律者·希儿（mesh Seele_HerrscherofRebirth_Body_pdx，裙甲为 attach 子网格，必须保留）
entity = {
	name = "HerrscherRebirthSeeleAir_entity"
	pdxmesh = "Seele_HerrscherofRebirth_Body_pdx"

	state = { name = "fire" animation = "Attack1" animation_blend_time = 0.1 animation_speed = 1.0 looping = no next_state = "fire" }
	state = { name = "bomb" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.9 looping = no next_state = "bomb" }
	state = { name = "firebomb" animation = "BranchAttack" animation_blend_time = 0.1 animation_speed = 1.0 looping = no next_state = "firebomb" }
	state = { name = "idle" animation = "Idle" animation_blend_time = 0.1 animation_speed = 0.9 looping = no next_state = "idle" }
	state = { name = "crash" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.9 looping = no next_state = "crash" }
	state = { name = "explode" animation = "Move" animation_blend_time = 0.1 animation_speed = 0.9 looping = no next_state = "explode" }

	attach = { name = "Seele_HerrscherofRebirth_ShortSkirt" ROOT = "Seele_HerrscherofRebirth_ShortSkirt_entity" }
	attach = { name = "Seele_HerrscherofRebirth_LongSkirt1" ROOT = "Seele_HerrscherofRebirth_LongSkirt1_entity" }
	attach = { name = "Seele_HerrscherofRebirth_LongSkirt2" ROOT = "Seele_HerrscherofRebirth_LongSkirt2_entity" }

	scale = 0.04
}

